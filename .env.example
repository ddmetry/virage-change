# Скопируйте в .env и экспортируйте переменные перед запуском (или задайте в systemd/Docker).
NODE_ENV=production
PORT=3000
HOST=127.0.0.1
BASE_URL=https://your-domain.example
TRUST_PROXY=1                 # 1, если сайт стоит за nginx/Cloudflare
ADMIN_USER=admin
ADMIN_PASSWORD=               # задайте при первом запуске (от 12 символов); иначе будет сгенерирован и показан один раз в логе
# DEMO=1                      # ТОЛЬКО локально: подставляет демо-реквизиты и адреса приёма
# TELEGRAM_BOT_TOKEN=         # уведомления администратору о новых заявках
# TELEGRAM_CHAT_ID=
# MAIL_WEBHOOK_URL=           # POST {to,subject,text} — ваш сервис отправки почты
# RATES_INTERVAL_SEC=60
# DATA_DIR=./data
